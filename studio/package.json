{
  "name": "kc-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Studio: every project, every shipped feature, and an agent that drafts the next one.",
  "scripts": {
    "briefs": "tsx scripts/write-briefs.mts",
    "build": "npm run scan:anything && tsc --noEmit && vite build && npm run pages:processes && tsx scripts/publish-when-asked.ts",
    "dev": "vite",
    "pages:processes": "tsx scripts/write-process-pages.mts",
    "preview": "vite preview",
    "processes": "tsx scripts/write-processes.mts",
    "publish:anything": "tsx scripts/publish-anything.ts",
    "scan:anything": "tsx scripts/scan-anything.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
